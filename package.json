{
  "name": "hyrdon-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Enkel lokal CRM för Hyrdon, Premium Motors och American Motors (lokal version, inga integrationer).",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "reset-demo": "node --disable-warning=ExperimentalWarning scripts/reset-demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-reporter=spec test/*.test.js",
    "test:ui": "node --disable-warning=ExperimentalWarning test/ui/mobile-flow.js",
    "build:demo": "node scripts/build-standalone.js",
    "test:demo": "node test/ui/standalone.js"
  }
}
